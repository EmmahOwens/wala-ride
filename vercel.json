{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "has": [{ "type": "host", "value": "admin.walaride.vercel.app" }],
      "source": "/(.*)",
      "destination": "/admin.html"
    },
    {
      "has": [{ "type": "host", "value": "driver.walaride.vercel.app" }],
      "source": "/(.*)",
      "destination": "/driver.html"
    },
    {
      "has": [{ "type": "host", "value": "admin.(.*)" }],
      "source": "/(.*)",
      "destination": "/admin.html"
    },
    {
      "has": [{ "type": "host", "value": "driver.(.*)" }],
      "source": "/(.*)",
      "destination": "/driver.html"
    },
    {
      "source": "/admin(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/driver(.*)",
      "destination": "/driver.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
